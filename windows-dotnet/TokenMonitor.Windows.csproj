<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TokenMonitor</AssemblyName>
    <RootNamespace>TokenMonitor.Windows</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\src\tokenmon.py" Link="tokenmon.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="FreeLlmApiQuery.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>
</Project>
