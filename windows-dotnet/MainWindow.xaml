<Window x:Class="TokenMonitor.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Token Monitor" Width="355" Height="165"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True">
  <Grid>
    <Border x:Name="Card" Margin="8" Padding="14,12,14,10" CornerRadius="18"
            Background="#D9111318" BorderBrush="#1CFFFFFF" BorderThickness="1"
            MouseLeftButtonDown="CardMouseDown">
      <Border.LayoutTransform>
        <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
      </Border.LayoutTransform>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition x:Name="GaugeRow" Height="120" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel x:Name="Gauges" Orientation="Horizontal" HorizontalAlignment="Center" />
        <TextBlock x:Name="Status" Grid.Row="1" Text="coletando…" FontSize="8"
                   Foreground="#8B93A6" HorizontalAlignment="Center" Margin="0,1,0,0" />
        <StackPanel x:Name="Credit" Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0">
          <Image x:Name="CreditIcon" Width="13" Height="13" Margin="0,0,5,0" Opacity="0.60" />
          <TextBlock x:Name="CreditLabel" FontSize="10" Foreground="#657083" />
        </StackPanel>
      </Grid>
    </Border>
    <Popup x:Name="DetailsPopup" AllowsTransparency="True" StaysOpen="True"
           PopupAnimation="Fade">
      <Border x:Name="DetailsCard" Width="380" Padding="17,15,17,13" CornerRadius="16"
              Background="#F7111318" BorderBrush="#22FFFFFF" BorderThickness="1">
        <Border.LayoutTransform>
          <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
        </Border.LayoutTransform>
        <StackPanel x:Name="DetailsContent" />
      </Border>
    </Popup>
  </Grid>
</Window>
